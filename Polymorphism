class Animal {
    void animalSound() {
        System.out.println("Animal Sound");
    }
}

class Pig extends Animal {
    @Override
    void animalSound() {
        System.out.println("Pig: Wee Wee");
    }
}

class Dog extends Animal {
    @Override
    void animalSound() {
        System.out.println("Dog: Bow Wow");
    }
}

public class Main {
    public static void main(String[] args) {

        Animal[] animals = {
            new Animal(),
            new Pig(),
            new Dog()
        };

        for (Animal a : animals) {
            a.animalSound();
        }
    }
}
